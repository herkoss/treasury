{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT e.id, e.proposal_id, e.asset_code, e.amount, a.scale, e.created_at\n        FROM entries e\n        JOIN assets a ON a.code = e.asset_code\n        WHERE e.account_id = $1 AND e.id > $2\n        ORDER BY e.id\n        LIMIT $3\n        ",
