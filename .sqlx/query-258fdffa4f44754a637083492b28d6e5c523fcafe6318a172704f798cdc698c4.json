{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, proposer_id, memo, expires_at, created_at, closed_at,\n               CASE WHEN state = 'pending' AND expires_at <= now() THEN 'expired' ELSE state END\n                   AS \"state!\"\n        FROM proposals\n        WHERE id = $1\n        ",
