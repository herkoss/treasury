  "query": "\n        SELECT l.from_id, l.to_id, l.asset_code, l.amount, a.scale\n        FROM legs l\n        JOIN assets a ON a.code = l.asset_code\n        WHERE l.proposal_id = $1\n        ORDER BY l.position\n        ",
