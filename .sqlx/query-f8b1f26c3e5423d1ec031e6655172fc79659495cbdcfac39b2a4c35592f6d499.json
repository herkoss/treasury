{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE assets\n        SET archived_at = now()\n        WHERE code = $1\n          AND archived_at IS NULL\n          AND NOT EXISTS (\n              SELECT 1 FROM entries\n              WHERE asset_code = $1\n              GROUP BY account_id\n              HAVING SUM(amount) <> 0\n          )\n          AND NOT EXISTS (\n              SELECT 1 FROM legs l\n              JOIN proposals p ON p.id = l.proposal_id\n              WHERE l.asset_code = $1\n                AND p.state = 'pending'\n                AND p.expires_at > now()\n          )\n        RETURNING code, name, scale, archived_at, created_at\n        ",
